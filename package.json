    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jest": "^30.5.2",
    "playwright-core": "^1.65.0",
    "ts-jest": "^29.4.15",
    "typescript": "5.9",
    "vite": "^8.3.6"
